# Obscurenv local development environment
#
# Copy this file to .env when you want to run services without Docker Compose:
#
#   cp .env.example .env
#
# Do not commit real production credentials.

# Backend PostgreSQL connection string.
# Used by backend/main.go.
DATABASE_URL=postgres://obv:obv@localhost:5432/obv?sslmode=disable

# Backend listen address.
# Used by backend/main.go. If unset, the backend uses PORT, then defaults to :8080.
ADDR=:8080

# Platform-provided port fallback, useful on hosts like Vercel.
# Leave empty for normal local development when ADDR is set.
PORT=

# CLI API base URL.
# Used by the obv CLI. Docker Compose exposes the backend at this URL locally.
OBV_API_URL=http://localhost:8080

# Docker Compose PostgreSQL defaults.
# These are consumed by the postgres image if you wire them into docker-compose.yml.
POSTGRES_USER=obv
POSTGRES_PASSWORD=obv
POSTGRES_DB=obv
